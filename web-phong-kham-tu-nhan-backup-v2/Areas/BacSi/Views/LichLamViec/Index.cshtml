@model List<web_phong_kham_tu_nhan.Models.Entities.LichLamViecBacSi>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lịch làm việc";
    DateTime startOfWeek = (DateTime)ViewBag.StartOfWeek;
    DateTime endOfWeek   = (DateTime)ViewBag.EndOfWeek;
    var doctor = ViewBag.Doctor as web_phong_kham_tu_nhan.Models.Entities.BacSi;
    string[] tenThuFull = { "Chủ nhật","Thứ 2","Thứ 3","Thứ 4","Thứ 5","Thứ 6","Thứ 7" };
    string[] cacas      = { "Sang","Chieu","CaNgay" };
    string[] caLabels   = { "Sáng","Chiều","Cả ngày" };
}
<link rel="stylesheet" href="~/css/BacSiHome/LichLamViec.css" />
<style>
/* ── CLICK-TO-REGISTER cell ── */
.empty-cell-btn {
    width:100%; min-height:52px; border:2px dashed #cbd5e1; border-radius:8px;
    background:transparent; color:#94a3b8; font-size:12px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    cursor:pointer; transition:.15s;
}
.empty-cell-btn:hover { border-color:#0d6efd; background:#eff6ff; color:#0d6efd; }
.empty-cell-btn i { font-size:16px; }
.empty-cell-past { min-height:52px; display:flex; align-items:center; justify-content:center;
                   color:#e2e8f0; font-size:18px; }
/* trạng thái 4 = chờ duyệt đăng ký */
.lich-cell-4 { background:#f5f3ff!important; border-color:#8b5cf6!important; }
.lich-cell-4 .cell-title { color:#8b5cf6!important; }
/* badge dot */
.dot-cho-duyet { display:inline-block;width:8px;height:8px;border-radius:50%;
                 background:#8b5cf6;margin-left:4px;vertical-align:middle; }
/* modal đăng ký nhanh */
.modal-reg-hd { background:linear-gradient(135deg,#0d6efd,#6ea8fe); }
/* nghỉ đột xuất checkbox */
.dot-xuat-wrap { display:flex;align-items:center;gap:8px;
                 background:#fef2f2;border-radius:8px;padding:10px 12px;
                 border:1px solid #fca5a5;margin-bottom:12px;cursor:pointer;font-size:13px;color:#ef4444; }
</style>

<div class="llv-page">
  <div class="container">
    <!-- TOAST -->
    <div class="notification-container" id="toastContainer">
      @if (TempData["Success"] != null)
      {
          <div class="custom-toast success" id="successToast">
              <span class="toast-icon"><i class="bi bi-check-circle-fill"></i></span>
              <div class="toast-content">
                  <div class="toast-title">Thành công</div>
                  <div class="toast-msg">@TempData["Success"]</div>
              </div>
              <button class="toast-close" onclick="closeToast('successToast')"><i class="bi bi-x"></i></button>
          </div>
      }
      @if (TempData["Error"] != null)
      {
          <div class="custom-toast error" id="errorToast">
              <span class="toast-icon"><i class="bi bi-x-circle-fill"></i></span>
              <div class="toast-content">
                  <div class="toast-title">Lỗi</div>
                  <div class="toast-msg">@TempData["Error"]</div>
              </div>
              <button class="toast-close" onclick="closeToast('errorToast')"><i class="bi bi-x"></i></button>
          </div>
      }
    </div>

    <a asp-area="BacSi" asp-controller="Profile" asp-action="Index" class="detail-back">
        <i class="bi bi-arrow-left"></i> Quay lại trang thông tin
    </a>

    <!-- HEADER -->
    <div class="llv-header">
      <div>
        <h2><i class="bi bi-calendar3 me-2"></i>Lịch làm việc của tôi</h2>
        <p>Xem lịch, đăng ký ca làm và gửi đơn xin nghỉ</p>
      </div>
      @if (doctor != null)
      {
          <div class="doctor-pill">
              <img src="@(doctor.ImageUrl ?? "/Images/default-avatar.png")"
                   onerror="this.src='/Images/default-avatar.png'" />
              <span>BS. @doctor.FullName</span>
          </div>
      }
    </div>

    <!-- STATS -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon" style="background:#eff6ff;color:#0d6efd"><i class="bi bi-calendar-check"></i></div>
        <div><div class="stat-num">@ViewBag.NgayLamThang</div><div class="stat-lbl">Ngày làm tháng này</div></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:#fffbeb;color:#f59e0b"><i class="bi bi-calendar-x"></i></div>
        <div><div class="stat-num">@ViewBag.NgayNghiThang</div><div class="stat-lbl">Ngày nghỉ tháng này</div></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:#fef9c3;color:#d97706"><i class="bi bi-hourglass-split"></i></div>
        <div>
          <div class="stat-num">
            @ViewBag.DonChoDuyet
            @if ((int)ViewBag.DonChoDuyet > 0) { <span class="dot-cho-duyet"></span> }
          </div>
          <div class="stat-lbl">Đơn chờ duyệt</div>
        </div>
      </div>
    </div>

    <!-- TIP CLICK -->
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3" style="border-radius:10px;font-size:13px">
      <i class="bi bi-lightbulb-fill text-warning"></i>
      <span>
        <strong>Mẹo:</strong> Bấm vào ô trống trong lịch tuần để <strong>đăng ký nhanh 1 ca</strong> mà không cần chọn khoảng ngày.
        Hoặc dùng form bên dưới để đăng ký nhiều ngày liên tục.
      </span>
    </div>

    <!-- FORM ĐĂNG KÝ CA LÀM (nhiều ngày) -->
    <div class="register-card">
      <h6><i class="bi bi-calendar-plus text-primary"></i> Đăng ký ca làm việc (khoảng ngày)</h6>
      <form asp-area="BacSi" asp-controller="LichLamViec" asp-action="DangKyCa" method="post">
        @Html.AntiForgeryToken()
        <div class="reg-grid">
          <div class="form-group">
            <label><i class="bi bi-calendar-event me-1"></i>Từ ngày</label>
            <input type="date" name="ngayBatDau" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
          </div>
          <div class="form-group">
            <label><i class="bi bi-calendar-event me-1"></i>Đến ngày</label>
            <input type="date" name="ngayKetThuc" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
          </div>
          <div class="form-group">
            <label><i class="bi bi-sun me-1"></i>Ca làm</label>
            <select name="ca" class="form-select form-select-sm">
              <option value="Sang">Sáng</option>
              <option value="Chieu">Chiều</option>
              <option value="CaNgay">Cả ngày</option>
            </select>
          </div>
          <div class="form-group">
            <label><i class="bi bi-people me-1"></i>Tối đa BN</label>
            <input type="number" name="soBenhNhanToiDa" class="form-control form-control-sm"
                   value="20" min="1" max="100" />
          </div>
          <div class="form-group" style="grid-column:1/4">
            <label><i class="bi bi-chat-text me-1"></i>Ghi chú</label>
            <input type="text" name="ghiChu" class="form-control form-control-sm"
                   placeholder="Ghi chú thêm (không bắt buộc)" />
          </div>
          <div>
            <button type="submit" class="btn-reg w-100">
              <i class="bi bi-plus-circle"></i> Đăng ký khoảng ngày
            </button>
          </div>
        </div>
      </form>
      <div class="mt-2" style="font-size:12px;color:#94a3b8">
        <i class="bi bi-info-circle me-1"></i>
        Lịch đăng ký sẽ chuyển sang trạng thái <strong>Chờ duyệt</strong> — Admin sẽ xem xét và phê duyệt.
      </div>
    </div>

    <!-- NAV TUẦN -->
    <div class="week-nav">
      <a href="@Url.Action("Index", new { tuan = startOfWeek.AddDays(-7).ToString("yyyy-MM-dd") })" class="btn-nav">
        <i class="bi bi-chevron-left"></i>
      </a>
      <div>
        <div class="week-label">@startOfWeek.ToString("dd/MM") — @endOfWeek.ToString("dd/MM/yyyy")</div>
        @if (startOfWeek <= DateTime.Today && DateTime.Today <= endOfWeek)
        { <small class="badge bg-primary" style="font-size:10px">Tuần này</small> }
      </div>
      <div style="display:flex;align-items:center;gap:6px">
        <a href="@Url.Action("Index", new { tuan = DateTime.Today.ToString("yyyy-MM-dd") })"
           class="btn btn-outline-primary btn-sm" style="border-radius:7px;font-size:12px">
          <i class="bi bi-calendar-day me-1"></i>Tuần này
        </a>
        <a href="@Url.Action("Index", new { tuan = startOfWeek.AddDays(7).ToString("yyyy-MM-dd") })" class="btn-nav">
          <i class="bi bi-chevron-right"></i>
        </a>
      </div>
    </div>

    <!-- LEGEND -->
    <div class="legend">
      <div class="legend-item"><div class="legend-dot" style="background:#eff6ff;border:1.5px solid #0d6efd"></div>Làm việc</div>
      <div class="legend-item"><div class="legend-dot" style="background:#fffbeb;border:1.5px solid #f59e0b"></div>Nghỉ phép</div>
      <div class="legend-item"><div class="legend-dot" style="background:#fef2f2;border:1.5px solid #ef4444"></div>Nghỉ bệnh / Đột xuất</div>
      <div class="legend-item"><div class="legend-dot" style="background:#fef9c3;border:1.5px solid #eab308"></div>Chờ duyệt nghỉ</div>
      <div class="legend-item"><div class="legend-dot" style="background:#f5f3ff;border:1.5px solid #8b5cf6"></div>Chờ duyệt đăng ký</div>
    </div>

    <!-- BẢNG LỊCH TUẦN -->
    <div class="week-table">
      <table>
        <thead>
          <tr>
            <th>Ca</th>
            @for (int i = 0; i < 7; i++)
            {
                DateTime ngay   = startOfWeek.AddDays(i);
                bool isToday    = ngay.Date == DateTime.Today;
                <th class="@(isToday ? "today-col" : "")">
                    <div class="th-date @(isToday ? "today" : "")">@ngay.Day</div>
                    <div style="font-size:10px;color:#94a3b8">@tenThuFull[(int)ngay.DayOfWeek]</div>
                    @if (isToday) { <small class="badge bg-primary" style="font-size:9px">Hôm nay</small> }
                </th>
            }
          </tr>
        </thead>
        <tbody>
          @for (int caIdx = 0; caIdx < cacas.Length; caIdx++)
          {
              string ca = cacas[caIdx];
              <tr>
                <td>@caLabels[caIdx]</td>
                @for (int i = 0; i < 7; i++)
                {
                    DateTime ngay = startOfWeek.AddDays(i);
                    bool isToday  = ngay.Date == DateTime.Today;
                    bool isPast   = ngay.Date < DateTime.Today;
                    var lichNgayCa = Model.Where(l => l.Ngay.Date == ngay.Date && l.CaLam == ca).ToList();
                    <td class="@(isToday ? "today-col" : "")">
                      @if (!lichNgayCa.Any())
                      {
                          @if (isPast)
                          {
                              <div class="empty-cell-past">—</div>
                          }
                          else
                          {
                              // ── Ô TRỐNG → NÚT ĐĂNG KÝ NHANH ──
                              <button type="button" class="empty-cell-btn"
                                      onclick="openModalDangKyNhanh('@ngay.ToString("yyyy-MM-dd")','@ca','@caLabels[caIdx]','@ngay.ToString("dd/MM/yyyy")')">
                                <i class="bi bi-plus-circle"></i>
                                <span>Đăng ký</span>
                              </button>
                          }
                      }
                      else
                      {
                          foreach (var l in lichNgayCa)
                          {
                              string ttLabel = l.TrangThai == 0 ? "Làm việc"
                                            : l.TrangThai == 1 ? "Nghỉ phép"
                                            : l.TrangThai == 2 ? "Nghỉ bệnh"
                                            : l.TrangThai == 3 ? "Chờ duyệt nghỉ"
                                            : l.TrangThai == 4 ? "Chờ duyệt ĐK"
                                            : l.TrangThai == 5 ? "Nghỉ đột xuất"
                                            : "—";
                              <div class="lich-cell lich-cell-@l.TrangThai">
                                <div class="cell-title">@ttLabel</div>
                                <div class="cell-sub">
                                  <i class="bi bi-people-fill"></i> @l.SoBenhNhanToiDa BN
                                </div>
                                @if (!string.IsNullOrEmpty(l.GhiChu))
                                {
                                    <div class="cell-note"><i class="bi bi-sticky"></i> @l.GhiChu</div>
                                }

                                @* NÚT XIN NGHỈ (cho ca đang làm việc, chưa qua) *@
                                @if (l.TrangThai == 0 && !isPast)
                                {
                                    <button class="btn-xinngh" title="Xin nghỉ"
                                            onclick="openModalXinNghi(@l.Id,'@ngay.ToString("dd/MM/yyyy")','@caLabels[caIdx]')">
                                      <i class="bi bi-x"></i>
                                    </button>
                                }

                                @* NÚT HỦY ĐƠN (chờ duyệt nghỉ hoặc chờ duyệt đk) *@
                                @if (l.TrangThai == 3 || l.TrangThai == 4)
                                {
                                    <form asp-area="BacSi" asp-controller="LichLamViec"
                                          asp-action="HuyDon" method="post" style="display:inline">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="id" value="@l.Id" />
                                      <button type="submit" class="btn-huyday" title="Hủy đơn">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                      </button>
                                    </form>
                                }
                              </div>
                          }
                      }
                    </td>
                }
              </tr>
          }
        </tbody>
      </table>
    </div><!-- end week-table -->
  </div>
</div>

<!-- ══════════════════════════════════════
     MODAL ĐĂNG KÝ NHANH (click ô trống)
══════════════════════════════════════ -->
<div class="modal-overlay" id="modalDangKy" onclick="closeModalById('modalDangKy',event)">
  <div class="modal-box">
    <div class="modal-hd modal-reg-hd">
      <h5><i class="bi bi-calendar-plus me-2"></i>Đăng ký nhanh ca làm</h5>
      <button class="modal-cl" onclick="closeById('modalDangKy')"><i class="bi bi-x"></i></button>
    </div>
    <div class="modal-bd">
      <div class="modal-info mb-3">
        <strong id="dkNhanhTitle">Ca – Ngày</strong>
        <span style="font-size:12px;color:#0d6efd">
          <i class="bi bi-info-circle me-1"></i>Lịch sẽ chờ Admin duyệt
        </span>
      </div>
      <form asp-area="BacSi" asp-controller="LichLamViec" asp-action="DangKyNhanh" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ngay" id="dkNhanhNgay" />
        <input type="hidden" name="ca"   id="dkNhanhCa"   />
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px">
            <i class="bi bi-people me-1"></i>Số bệnh nhân tối đa
          </label>
          <input type="number" name="soBenhNhanToiDa" class="form-control form-control-sm"
                 value="20" min="1" max="100" />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px">
            <i class="bi bi-chat-text me-1"></i>Ghi chú
          </label>
          <input type="text" name="ghiChu" class="form-control form-control-sm"
                 placeholder="Ghi chú thêm (không bắt buộc)" />
        </div>
        <div class="alert alert-primary d-flex gap-2 mb-3" style="border-radius:8px;font-size:12px">
          <i class="bi bi-info-circle-fill mt-1"></i>
          <span>Ca đăng ký sẽ hiển thị trạng thái <strong>Chờ duyệt đăng ký</strong> cho đến khi Admin phê duyệt.</span>
        </div>
        <button type="submit" class="btn-reg w-100">
          <i class="bi bi-send me-2"></i>Gửi đăng ký cho Admin
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════
     MODAL XIN NGHỈ (thường + đột xuất)
══════════════════════════════════════ -->
<div class="modal-overlay" id="modalXinNghi" onclick="closeModalById('modalXinNghi',event)">
  <div class="modal-box">
    <div class="modal-hd" style="background:linear-gradient(135deg,#ef4444,#f87171)">
      <h5><i class="bi bi-calendar-x me-2"></i>Gửi đơn xin nghỉ</h5>
      <button class="modal-cl" onclick="closeById('modalXinNghi')"><i class="bi bi-x"></i></button>
    </div>
    <div class="modal-bd">
      <div class="modal-info mb-3">
        <strong id="xnTitle">Ca – Ngày</strong>
      </div>
      <form asp-area="BacSi" asp-controller="LichLamViec" asp-action="XinNghi" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="xnLichId" />

        <!-- CHECKBOX NGHỈ ĐỘT XUẤT -->
        <label class="dot-xuat-wrap" for="chkDotXuat">
          <input type="checkbox" name="dotXuat" id="chkDotXuat" value="true" style="width:16px;height:16px" />
          <div>
            <strong>Nghỉ đột xuất (khẩn cấp)</strong>
            <div style="font-size:11px;color:#f87171;margin-top:2px">
              Hệ thống sẽ tự động thông báo đến tất cả bệnh nhân có lịch hẹn trong ngày đó khi được Admin duyệt.
            </div>
          </div>
        </label>

        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px">
            <i class="bi bi-chat-text text-danger me-1"></i>Lý do xin nghỉ
          </label>
          <textarea name="lyDo" class="form-control" rows="3"
                    placeholder="Nhập lý do xin nghỉ..."
                    style="border-radius:8px;font-size:13px"></textarea>
        </div>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
             style="border-radius:8px;font-size:12px">
          <i class="bi bi-exclamation-triangle-fill"></i>
          Đơn chờ Admin xác nhận. Lịch hẹn trong ngày đó <strong>chưa bị ảnh hưởng</strong> cho đến khi được duyệt.
        </div>
        <button type="submit" class="btn-submit-nghi">
          <i class="bi bi-send me-2"></i>Gửi đơn xin nghỉ
        </button>
      </form>
    </div>
  </div>
</div>

<script>
// ── Modal Đăng ký nhanh ─────────────────────────────
function openModalDangKyNhanh(ngay, ca, caLabel, ngayHienThi) {
    document.getElementById('dkNhanhNgay').value  = ngay;
    document.getElementById('dkNhanhCa').value    = ca;
    document.getElementById('dkNhanhTitle').textContent = caLabel + ' — ' + ngayHienThi;
    document.getElementById('modalDangKy').classList.add('show');
}

// ── Modal Xin nghỉ ──────────────────────────────────
function openModalXinNghi(id, ngay, caLabel) {
    document.getElementById('xnLichId').value    = id;
    document.getElementById('xnTitle').textContent = caLabel + ' — ngày ' + ngay;
    document.getElementById('chkDotXuat').checked = false;
    document.getElementById('modalXinNghi').classList.add('show');
}

// ── Đóng modal ──────────────────────────────────────
function closeModalById(modalId, e) {
    if (e.target === document.getElementById(modalId))
        document.getElementById(modalId).classList.remove('show');
}
function closeById(modalId) {
    document.getElementById(modalId).classList.remove('show');
}

// ── Toast auto-close ─────────────────────────────────
function closeToast(id) {
    const t = document.getElementById(id);
    if (!t || t.classList.contains('toast-out')) return;
    t.classList.add('toast-out');
    t.addEventListener('transitionend', e => {
        if (e.propertyName === 'opacity' || e.propertyName === 'transform') t.remove();
    }, { once: true });
}
document.addEventListener('DOMContentLoaded', () => {
    ['successToast','errorToast'].forEach(id => {
        const t = document.getElementById(id);
        if (t) setTimeout(() => closeToast(id), 3000);
    });
});
</script>
