@model web_phong_kham_tu_nhan.Models.Entities.LichHen

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string[] dayNames = { "Chủ nhật", "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7" };
}
<link rel="stylesheet" href="~/css/BenhNhanHome/Reschedule.css"/>
<div class="reschedule-page">
    <div class="container" style="max-width:680px">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" style="border-radius:10px">
                <i class="bi bi-exclamation-circle-fill fs-5"></i> @TempData["Error"]
            </div>
        }

        <div class="page-header">
            <div class="page-icon"><i class="bi bi-calendar-event"></i></div>
            <div>
                <h1 class="page-title">Đổi lịch khám</h1>
                <p class="page-sub">Chọn ngày và giờ mới phù hợp với bạn</p>
            </div>
        </div>

        <!-- LƯU Ý -->
        <div class="notice-box">
            <strong><i class="bi bi-info-circle-fill me-1"></i>Lưu ý khi đổi lịch:</strong>
            <ul>
                <li>Sau khi gửi, lịch sẽ chuyển sang trạng thái <strong>"Chờ xác nhận lại"</strong></li>
                <li>Bác sĩ sẽ xem xét và xác nhận hoặc từ chối yêu cầu của bạn</li>
                <li>Lịch hẹn cũ vẫn còn hiệu lực cho đến khi bác sĩ duyệt</li>
            </ul>
        </div>

        <!-- LỊCH HIỆN TẠI -->
        <div class="current-card">
            <div class="current-card-hd">
                <i class="bi bi-calendar-check-fill"></i>
                <h6>Lịch hẹn hiện tại</h6>
            </div>
            <div class="current-card-bd">
                <div class="cur-grid">
                    <div class="cur-item">
                        <div class="cur-lbl"><i class="bi bi-person-badge"></i> Bác sĩ</div>
                        <div class="cur-val">@(Model.BacSi?.FullName ?? "—")</div>
                    </div>
                    <div class="cur-item">
                        <div class="cur-lbl"><i class="bi bi-hospital"></i> Chuyên khoa</div>
                        <div class="cur-val">@(Model.ChuyenKhoa?.Name ?? "—")</div>
                    </div>
                    <div class="cur-item">
                        <div class="cur-lbl"><i class="bi bi-calendar3"></i> Ngày khám</div>
                        <div class="cur-val">
                            @dayNames[(int)Model.AppointmentDate.DayOfWeek],
                            @Model.AppointmentDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <div class="cur-item">
                        <div class="cur-lbl"><i class="bi bi-clock"></i> Giờ khám</div>
                        <div class="cur-val">@(Model.TimeSlot ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FORM ĐỔI LỊCH -->
        <form asp-area="BenhNhan" asp-controller="LichHen" asp-action="Reschedule"
              asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newTimeSlot" id="hNewSlot" />

            <!-- NGÀY MỚI -->
            <div class="form-card">
                <div class="form-card-hd">
                    <i class="bi bi-calendar-event-fill"></i>
                    <div><h6>Chọn ngày mới</h6></div>
                </div>
                <div class="form-card-bd">
                    <div class="fg">
                        <label><i class="bi bi-calendar3"></i> Ngày khám mới</label>
                        <input type="date" name="newDate" id="inputNewDate" class="fc"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required onchange="onDateChange(this.value)" />
                    </div>
                    <div id="todayNotice" style="display:none;margin-top:10px">
                        <div class="time-warning show">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Bạn đã chọn <strong>hôm nay</strong> — chỉ các khung giờ
                            từ <strong id="minTimeStr"></strong> trở đi mới khả dụng.
                        </div>
                    </div>
                </div>
            </div>

            <!-- GIỜ MỚI -->
            <div class="form-card" id="slotCard" style="display:none">
                <div class="form-card-hd">
                    <i class="bi bi-clock-fill"></i>
                    <div><h6>Chọn giờ khám mới</h6></div>
                </div>
                <div class="form-card-bd">
                    <div id="slotLoading" style="text-align:center;padding:20px;color:#94a3b8;display:none">
                        <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                        Đang tải khung giờ...
                    </div>
                    <div class="slot-grid" id="slotGrid"></div>
                    <div class="slot-legend">
                        <div class="sl-item">
                            <div class="sl-dot" style="background:#38BDF8"></div> Chọn được
                        </div>
                        <div class="sl-item">
                            <div class="sl-dot" style="background:#f1f5f9;border:1px solid #e2e8f0"></div> Đã đặt
                        </div>
                        <div class="sl-item">
                            <div class="sl-dot" style="background:#fef2f2;border:1px solid #fecaca"></div> Đã qua
                        </div>
                    </div>
                    <div id="slotError" style="color:#ef4444;font-size:13px;margin-top:8px;display:none">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        Vui lòng chọn một khung giờ.
                    </div>
                </div>
            </div>

            <!-- LÝ DO ĐỔI LỊCH -->
            <div class="form-card">
                <div class="form-card-hd">
                    <i class="bi bi-chat-text-fill"></i>
                    <div>
                        <h6>Lý do đổi lịch</h6>
                        <p>Giải thích giúp bác sĩ hiểu và xem xét nhanh hơn</p>
                    </div>
                </div>
                <div class="form-card-bd">
                    <div class="fg">
                        <label><i class="bi bi-pencil"></i> Lý do (không bắt buộc)</label>
                        <textarea name="rescheduleNote" class="fc" rows="3"
                                  placeholder="VD: Bận công tác đột xuất, xin đổi sang ngày khác..."></textarea>
                    </div>
                </div>
            </div>

            <div class="submit-row">
                <button type="submit" class="btn-submit" onclick="return validateForm()">
                    <i class="bi bi-send-fill"></i> Gửi yêu cầu đổi lịch
                </button>
                <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="MyAppointment"
                   class="btn-cancel">
                    Hủy bỏ
                </a>
            </div>

        </form>
    </div>
</div>

<script>
    var ALL_SLOTS = [
        '07:30','08:00','08:30','09:00','09:30','10:00','10:30','11:00',
        '13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30'
    ];
    var DOCTOR_ID  = @Model.BacSiId;
    var CURRENT_ID = @Model.Id;

    function onDateChange(dateVal) {
        if (!dateVal) { document.getElementById('slotCard').style.display='none'; return; }

        var today    = new Date(); today.setHours(0,0,0,0);
        var selected = new Date(dateVal);
        var isToday  = selected.getTime() === today.getTime();

        // Hiện/ẩn cảnh báo hôm nay
        var todayNotice = document.getElementById('todayNotice');
        if (isToday) {
            var now = new Date();
            var minH = now.getHours();
            var minM = now.getMinutes() + 30;
            if (minM >= 60) { minH++; minM -= 60; }
            document.getElementById('minTimeStr').textContent =
                String(minH).padStart(2,'0') + ':' + String(minM).padStart(2,'0');
            todayNotice.style.display = 'block';
        } else {
            todayNotice.style.display = 'none';
        }

        loadSlots(dateVal, isToday);
    }

    function loadSlots(dateVal, isToday) {
        document.getElementById('slotCard').style.display    = 'block';
        document.getElementById('slotLoading').style.display = 'block';
        document.getElementById('slotGrid').innerHTML        = '';
        document.getElementById('hNewSlot').value            = '';

        fetch('/BenhNhan/LichHen/GetBookedSlots?bacSiId=' + DOCTOR_ID + '&date=' + dateVal)
            .then(function(r){ return r.json(); })
            .then(function(data) {
                document.getElementById('slotLoading').style.display = 'none';
                renderSlots(data.booked || [], data.past || []);
            })
            .catch(function() {
                document.getElementById('slotLoading').style.display = 'none';
                renderSlots([], []);
            });
    }

    function renderSlots(booked, past) {
        var grid = document.getElementById('slotGrid');
        grid.innerHTML = '';
        ALL_SLOTS.forEach(function(s) {
            var isBooked = booked.includes(s);
            var isPast   = past.includes(s);
            var cls = 'slot-btn';
            if (isBooked) cls += ' booked';
            else if (isPast) cls += ' past';

            var btn = document.createElement('div');
            btn.className    = cls;
            btn.dataset.slot = s;
            btn.textContent  = s;

            if (!isBooked && !isPast) {
                btn.onclick = function() { selectSlot(this); };
            }
            grid.appendChild(btn);
        });
    }

    function selectSlot(el) {
        document.querySelectorAll('.slot-btn').forEach(function(b){ b.classList.remove('selected'); });
        el.classList.add('selected');
        document.getElementById('hNewSlot').value = el.dataset.slot;
        document.getElementById('slotError').style.display = 'none';
    }

    function validateForm() {
        if (!document.getElementById('hNewSlot').value) {
            document.getElementById('slotCard').style.display = 'block';
            document.getElementById('slotError').style.display = 'block';
            document.getElementById('slotError').scrollIntoView({behavior:'smooth', block:'center'});
            return false;
        }
        if (!document.getElementById('inputNewDate').value) {
            alert('Vui lòng chọn ngày khám mới.');
            return false;
        }
        return true;
    }
</script>