@model List<web_phong_kham_tu_nhan.Models.Entities.LichLamViecBacSi>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Đơn xin nghỉ";
    string[] tenThu = {"CN","T2","T3","T4","T5","T6","T7"};
}
<link rel="stylesheet" href="~/css/Admin/DonXinNghi.css" />
<style>
.don-card { background:#fff; border-radius:12px; padding:16px 20px; margin-bottom:12px;
            box-shadow:0 1px 6px rgba(0,0,0,.07); border-left:4px solid #f59e0b;
            display:flex; align-items:flex-start; gap:16px; flex-wrap:wrap; }
.don-card.dot-xuat { border-left-color:#ef4444; }
.don-avatar { width:44px; height:44px; border-radius:10px; background:#fffbeb; color:#d97706;
              display:flex; align-items:center; justify-content:center;
              font-size:1.2rem; font-weight:700; flex-shrink:0; }
.don-card.dot-xuat .don-avatar { background:#fef2f2; color:#ef4444; }
.don-info { flex:1; min-width:200px; }
.don-name { font-weight:700; font-size:14px; color:#1e293b; }
.don-meta { font-size:12px; color:#64748b; margin-top:4px; display:flex; flex-wrap:wrap; gap:12px; }
.don-lydo { font-size:12px; color:#64748b; margin-top:6px; font-style:italic; }
.don-actions { display:flex; gap:8px; flex-shrink:0; align-items:center; }
.btn-chitiet { background:#0d6efd; color:#fff; border:none; border-radius:8px;
               padding:8px 16px; font-size:12px; font-weight:600; cursor:pointer;
               display:flex; align-items:center; gap:5px; text-decoration:none; }
.btn-chitiet:hover { opacity:.88; color:#fff; }
.dot-xuat-badge { display:inline-flex; align-items:center; gap:4px; background:#fef2f2;
                  color:#ef4444; border:1px solid #fca5a5; border-radius:6px;
                  padding:2px 8px; font-size:11px; font-weight:600; margin-left:6px; }
.ca-pill { display:inline-flex; align-items:center; gap:4px; border-radius:6px;
           padding:2px 8px; font-size:11px; font-weight:600; }
.empty-box { text-align:center; padding:60px 20px; color:#94a3b8; }
.empty-box i { font-size:3rem; display:block; margin-bottom:10px; }
.page-hd { display:flex; justify-content:space-between; align-items:center;
           margin-bottom:20px; flex-wrap:wrap; gap:10px; }
.page-hd h4 { margin:0; font-size:1.15rem; font-weight:700; color:#1e3a5f; }
</style>

<div class="container">
    <div class="page-hd">
        <h4>
            <i class="bi bi-bell-fill me-2 text-warning"></i>Đơn xin nghỉ chờ duyệt
            @if (Model.Any())
            { <span class="badge bg-warning text-dark ms-2">@Model.Count</span> }
        </h4>
        <a asp-area="Admin" asp-controller="LichLamViecBacSi" asp-action="Index"
           class="btn btn-outline-secondary btn-sm" style="border-radius:8px">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex gap-2 mb-3" style="border-radius:10px">
            <i class="bi bi-check-circle-fill mt-1"></i> @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-check2-circle text-success"></i>
            <h5>Không có đơn xin nghỉ nào</h5>
            <p>Tất cả đơn đã được xử lý.</p>
        </div>
    }
    else
    {
        <div class="alert alert-info d-flex gap-2 mb-3" style="border-radius:10px;font-size:13px">
            <i class="bi bi-info-circle-fill mt-1"></i>
            <span>Bấm <strong>Xem & Duyệt</strong> để xem số lịch hẹn bị ảnh hưởng trước khi đưa ra quyết định.</span>
        </div>

        @foreach (var item in Model)
        {
            string caLabel = item.CaLam == "Sang" ? "Ca sáng"
                           : item.CaLam == "Chieu" ? "Ca chiều" : "Cả ngày";
            string caColor = item.CaLam == "Sang" ? "#0d6efd"
                           : item.CaLam == "Chieu" ? "#f59e0b" : "#10b981";
            bool isDotXuat = (item.GhiChu ?? "").Contains("[Nghỉ đột xuất]")
                          || (item.LyDoXinNghi ?? "").Contains("đột xuất");

            // Đếm số lịch hẹn bị ảnh hưởng
            int soLH = Context.RequestServices
                .GetRequiredService<web_phong_kham_tu_nhan.Data.ApplicationDbContext>()
                .Appointments.Count(a =>
                    a.BacSiId == item.BacSiId &&
                    a.AppointmentDate.Date == item.Ngay.Date &&
                    (a.TrangThai == 0 || a.TrangThai == 1));

            <div class="don-card @(isDotXuat ? "dot-xuat" : "")">
                <div class="don-avatar">@((item.BacSi?.FullName ?? "?")[0])</div>
                <div class="don-info">
                    <div class="don-name">
                        BS. @(item.BacSi?.FullName ?? "—")
                        @if (isDotXuat)
                        {
                            <span class="dot-xuat-badge"><i class="bi bi-lightning-fill"></i> Đột xuất</span>
                        }
                    </div>
                    <div class="don-meta">
                        <span><i class="bi bi-calendar-event"></i> @tenThu[(int)item.Ngay.DayOfWeek], @item.Ngay.ToString("dd/MM/yyyy")</span>
                        <span class="ca-pill" style="background:@(caColor)1a;color:@caColor;border:1px solid @(caColor)40">
                            @caLabel
                        </span>
                        @if (soLH > 0)
                        {
                            <span style="color:#ef4444;font-weight:600">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@soLH lịch hẹn bị ảnh hưởng
                            </span>
                        }
                        else
                        {
                            <span style="color:#10b981">
                                <i class="bi bi-check-circle me-1"></i>Không có lịch hẹn
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(item.LyDoXinNghi))
                    {
                        <div class="don-lydo">
                            <i class="bi bi-chat-text me-1"></i>@item.LyDoXinNghi
                        </div>
                    }
                </div>
                <div class="don-actions">
                    <a asp-area="Admin" asp-controller="LichLamViecBacSi"
                       asp-action="ChiTietDon" asp-route-id="@item.Id"
                       class="btn-chitiet">
                        <i class="bi bi-eye"></i> Xem &amp; Duyệt
                    </a>
                </div>
            </div>
        }
    }
</div>
