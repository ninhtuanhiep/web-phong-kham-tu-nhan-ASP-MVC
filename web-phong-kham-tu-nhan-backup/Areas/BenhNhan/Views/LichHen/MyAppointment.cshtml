@model List<web_phong_kham_tu_nhan.Models.Entities.LichHen>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Lấy toast từ TempData
    string? toastType = TempData["ToastType"] as string;
    string? toastMessage = TempData["ToastMessage"] as string;

    // Flag reschedule thành công
    bool rescheduleSuccess = TempData["RescheduleSuccess"] as string == "true";
    string? rsNewDate = TempData["RescheduleNewDate"] as string;
    string? rsNewSlot = TempData["RescheduleNewSlot"] as string;
}
<link rel="stylesheet" href="~/css/BenhNhanHome/myAppointment.css"/>
<div class="appt-page">
    <!-- THÊM DÒNG NÀY VÀO ĐÂY -->
    <div id="toastContainer" class="toast-container"></div>
    <div class="container">

        <div class="appt-header">
            <div>
                <h2><i class="bi bi-calendar2-week me-2"></i>Lịch hẹn của tôi</h2>
                <p>Quản lý toàn bộ lịch khám tại Phòng Khám An Khang</p>
            </div>
            <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="Create"
               class="btn btn-light fw-bold px-4 " style="border-radius:50px">
                <i class="bi bi-plus-circle me-2"></i>Đặt lịch mới
            </a>
        </div>

        <div class="filter-tabs">
            <button class="filter-tab active" onclick="filterAppt('all',this)">
                Tất cả <span class="badge bg-secondary ms-1">@Model.Count</span>
            </button>
            <button class="filter-tab" onclick="filterAppt('0',this)">
                <i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận
                <span class="badge bg-warning text-dark ms-1">@Model.Count(a => a.TrangThai == 0)</span>
            </button>
            <button class="filter-tab" onclick="filterAppt('1',this)">
                <i class="bi bi-calendar-check me-1"></i>Đã xác nhận
                <span class="badge bg-primary ms-1">@Model.Count(a => a.TrangThai == 1)</span>
            </button>
            <button class="filter-tab" onclick="filterAppt('2',this)">
                <i class="bi bi-patch-check me-1"></i>Hoàn thành
                <span class="badge bg-success ms-1">@Model.Count(a => a.TrangThai == 2)</span>
            </button>
            <button class="filter-tab" onclick="filterAppt('3',this)">
                <i class="bi bi-x-circle me-1"></i>Đã hủy
                <span class="badge bg-secondary ms-1">@Model.Count(a => a.TrangThai == 3)</span>
            </button>
        </div>
        @if (rescheduleSuccess)
        {
            <div class="rs-banner" id="rsBanner">
                <div class="rs-banner-icon"><i class="bi bi-send-check-fill"></i></div>
                <div style="flex:1">
                    <div class="rs-banner-title">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Yêu cầu đổi lịch đã được gửi thành công!
                    </div>
                    <div class="rs-banner-body">
                        Yêu cầu chuyển sang ngày <strong>@rsNewDate</strong>
                        lúc <strong>@rsNewSlot</strong> đã được gửi đến bác sĩ.
                        <div class="rs-banner-steps">
                            <div class="rs-step"><i class="bi bi-check2-circle"></i> Bác sĩ sẽ xem xét yêu cầu của bạn</div>
                            <div class="rs-step"><i class="bi bi-check2-circle"></i> Bạn sẽ thấy trạng thái "Chờ xác nhận lại" bên dưới</div>
                            <div class="rs-step"><i class="bi bi-check2-circle"></i> Lịch cũ vẫn có hiệu lực cho đến khi được duyệt</div>
                        </div>
                    </div>
                </div>
                <button onclick="document.getElementById('rsBanner').remove()"
                        style="background:none;border:none;color:#4ade80;cursor:pointer;font-size:18px;padding:0;align-self:flex-start">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-box">
                <i class="bi bi-calendar-x"></i>
                <h5>Chưa có lịch hẹn nào</h5>
                <p>Hãy đặt lịch khám để được chăm sóc sức khỏe tốt nhất.</p>
                <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="Create"
                   class="btn btn-primary px-4 mt-2" style="border-radius:8px">
                    <i class="bi bi-plus-circle me-2"></i>Đặt lịch ngay
                </a>
            </div>
        }
        else
        {
            <div id="apptList">
                @foreach (var item in Model)
                {
                    string ttLabel = "Không xác định";
                    string ttBadge = "secondary";
                    string ttIcon = "bi-question-circle";

                    if (item.TrangThai == 0) { ttLabel = "Chờ xác nhận"; ttBadge = "warning"; ttIcon = "bi-hourglass-split"; }
                    else if (item.TrangThai == 1) { ttLabel = "Đã xác nhận"; ttBadge = "primary"; ttIcon = "bi-calendar-check"; }
                    else if (item.TrangThai == 2) { ttLabel = "Hoàn thành"; ttBadge = "success"; ttIcon = "bi-patch-check-fill"; }
                    else if (item.TrangThai == 3) { ttLabel = "Đã hủy"; ttBadge = "secondary"; ttIcon = "bi-x-circle"; }
                    else if (item.TrangThai == 4) { ttLabel = "Chờ xác nhận lại"; ttBadge = "warning"; ttIcon = "bi-hourglass-split"; }

                    <div class="appt-card" data-status="@item.TrangThai">
                        <div class="appt-card-top">
                            <span class="appt-id"><i class="bi bi-hash"></i>LH-@item.Id.ToString("D4")</span>
                            <span class="appt-date-lbl"><i class="bi bi-calendar3"></i>Đặt ngày @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="appt-body">
                            <img src="@(item.BacSi != null && item.BacSi.ImageUrl != null ? item.BacSi.ImageUrl : "/Images/default-avatar.png")"
                                 class="appt-img"
                                 onerror="this.src='/Images/default-avatar.png'"
                                 alt="@(item.BacSi != null ? item.BacSi.FullName : "")" />
                            <div>
                                <div class="appt-doctor-name">@(item.BacSi != null ? item.BacSi.FullName : "Chưa xác định")</div>
                                <div class="appt-spec">@(item.ChuyenKhoa != null ? item.ChuyenKhoa.Name : "")</div>
                                <div class="appt-meta">
                                    <span class="appt-meta-item"><i class="bi bi-calendar-event"></i>@item.AppointmentDate.ToString("dd/MM/yyyy")</span>
                                    <span class="appt-meta-item"><i class="bi bi-clock"></i>@item.TimeSlot</span>
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-@ttBadge bg-opacity-10 text-@ttBadge border border-@ttBadge border-opacity-25 d-inline-flex align-items-center gap-1 p-2">
                                    <i class="bi @ttIcon"></i> @ttLabel
                                </span>
                            </div>
                        </div>
                        <div class="appt-footer">
                            <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="Detail" asp-route-id="@item.Id" class="btn-detail">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            @if (item.TrangThai == 0 || item.TrangThai == 1)
                            {
                                <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="Reschedule" asp-route-id="@item.Id" class="btn-reschedule">
                                    <i class="bi bi-arrow-repeat"></i> Đổi lịch
                                </a>
                                <form asp-area="BenhNhan" asp-controller="LichHen" asp-action="Cancel" method="post" style="display:inline"
                                      onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-cancel"><i class="bi bi-x-circle"></i> Hủy lịch</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
<script>
    function filterAppt(status, btn) {
        document.querySelectorAll('.filter-tab').forEach(function(t){ t.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('.appt-card').forEach(function(c){
            c.style.display = (status === 'all' || c.dataset.status === status) ? '' : 'none';
        });
    }
</script>
<script>
    // ── TOAST ENGINE ──
    var TOAST_ICONS = {
        success: 'bi-check-circle-fill',
        error:   'bi-exclamation-circle-fill',
        warning: 'bi-exclamation-triangle-fill',
        info:    'bi-info-circle-fill'
    };
    var TOAST_TITLES = {
        success: 'Thành công',
        error:   'Lỗi',
        warning: 'Cảnh báo',
        info:    'Thông báo'
    };

    function showToast(type, message, duration) {
        duration = duration || 4000;
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-item toast-' + type;
        toast.style.position = 'relative';       // cần cho progress bar
        toast.style.overflow = 'hidden';

        toast.innerHTML =
            '<i class="bi ' + (TOAST_ICONS[type]||'bi-info-circle-fill') + ' toast-icon"></i>'
            + '<div style="flex:1">'
            +   '<div class="toast-title">' + (TOAST_TITLES[type]||'Thông báo') + '</div>'
            +   '<div class="toast-msg">'  + message + '</div>'
            + '</div>'
            + '<button class="toast-close" onclick="closeToast(this.closest(\'.toast-item\'))">×</button>'
            + '<div class="toast-progress" style="animation-duration:' + duration + 'ms"></div>';

        container.appendChild(toast);

        // Auto-hide sau duration
        var timer = setTimeout(function() { closeToast(toast); }, duration);

        // Hover → tạm dừng đếm ngược
        toast.addEventListener('mouseenter', function() {
            clearTimeout(timer);
            toast.querySelector('.toast-progress').style.animationPlayState = 'paused';
        });
        toast.addEventListener('mouseleave', function() {
            toast.querySelector('.toast-progress').style.animationPlayState = 'running';
            timer = setTimeout(function() { closeToast(toast); }, 800);
        });
    }

    function closeToast(el) {
        if (!el || el.classList.contains('hiding')) return;
        el.classList.add('hiding');
        setTimeout(function() {
            if (el.parentElement) el.parentElement.removeChild(el);
        }, 300);
    }

    // ── HIỂN THỊ TOAST TỪ TEMPDATA ──
    document.addEventListener('DOMContentLoaded', function() {
        @if (!string.IsNullOrEmpty(toastType) && !string.IsNullOrEmpty(toastMessage))
        {
                <text>
                showToast('@toastType', '@Html.Raw(toastMessage.Replace("'", "\\'"))');
                </text>
        }
    });
</script>