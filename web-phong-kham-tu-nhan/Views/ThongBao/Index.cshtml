@model List<web_phong_kham_tu_nhan.Models.Entities.ThongBao>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thong bao cua toi";
}

<style>
.tb-page { max-width: 780px; margin: 0 auto; padding: 32px 16px; }
.tb-header { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
.tb-header h2 { margin: 0; font-size: 1.5rem; font-weight: 700; color: #1e3a5f; }
.tb-badge { background: #ef4444; color: #fff; border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: 700; }
.tb-empty { text-align: center; color: #94a3b8; padding: 60px 0; }
.tb-empty i { font-size: 3rem; display: block; margin-bottom: 10px; }
.tb-item { display: flex; gap: 14px; align-items: flex-start;
           background: #fff; border-radius: 12px; padding: 16px 20px;
           margin-bottom: 12px; box-shadow: 0 1px 6px rgba(0,0,0,.07);
           border-left: 4px solid #e2e8f0; }
.tb-item.unread { border-left-color: #0d6efd; background: #f0f7ff; }
.tb-item.type-BacSiNghi { border-left-color: #ef4444; }
.tb-item.type-NhacLich   { border-left-color: #0d6efd; }
.tb-item.type-LichDuyet  { border-left-color: #10b981; }
.tb-item.type-DangKyLich { border-left-color: #8b5cf6; }
.tb-item.type-XinNghi    { border-left-color: #f59e0b; }
.tb-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center;
           justify-content: center; font-size: 18px; flex-shrink: 0; }
.tb-icon.NhacLich   { background: #eff6ff; color: #0d6efd; }
.tb-icon.BacSiNghi  { background: #fef2f2; color: #ef4444; }
.tb-icon.LichDuyet  { background: #f0fdf4; color: #10b981; }
.tb-icon.DangKyLich { background: #f5f3ff; color: #8b5cf6; }
.tb-icon.XinNghi    { background: #fffbeb; color: #f59e0b; }
.tb-body { flex: 1; }
.tb-tieu-de { font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 4px; }
.tb-noi-dung { font-size: 13px; color: #475569; line-height: 1.5; }
.tb-time { font-size: 11px; color: #94a3b8; margin-top: 6px; }
.tb-dot { width: 8px; height: 8px; border-radius: 50%; background: #0d6efd;
          flex-shrink: 0; margin-top: 6px; }
</style>

<div class="tb-page">
    <div class="tb-header">
        <i class="bi bi-bell-fill" style="font-size:1.8rem;color:#0d6efd"></i>
        <h2>Thong bao cua toi</h2>
        @{ int soMoi = Model.Count(t => !t.DaDoc); }
        @if (soMoi > 0)
        {
            <span class="tb-badge">@soMoi moi</span>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="tb-empty">
            <i class="bi bi-bell-slash"></i>
            Ban chua co thong bao nao.
        </div>
    }
    else
    {
        @foreach (var tb in Model)
        {
            string icon = tb.LoaiThongBao switch {
                "NhacLich"   => "bi-alarm",
                "BacSiNghi"  => "bi-exclamation-triangle-fill",
                "LichDuyet"  => "bi-check-circle-fill",
                "DangKyLich" => "bi-calendar-plus-fill",
                "XinNghi"    => "bi-calendar-x-fill",
                _            => "bi-info-circle-fill"
            };
            <div class="tb-item type-@tb.LoaiThongBao @(!tb.DaDoc ? "unread" : "")">
                <div class="tb-icon @tb.LoaiThongBao">
                    <i class="bi @icon"></i>
                </div>
                <div class="tb-body">
                    <div class="tb-tieu-de">@tb.TieuDe</div>
                    <div class="tb-noi-dung">@tb.NoiDung</div>
                    <div class="tb-time">
                        <i class="bi bi-clock me-1"></i>@tb.ThoiGianTao.ToString("HH:mm - dd/MM/yyyy")
                    </div>
                    @if (tb.LichHenId.HasValue && (tb.LoaiThongBao == "NhacLich" || tb.LoaiThongBao == "BacSiNghi"))
                    {
                        <a asp-area="BenhNhan" asp-controller="LichHen" asp-action="MyAppointment"
                           class="btn btn-sm btn-outline-primary mt-2" style="border-radius:7px;font-size:12px">
                            <i class="bi bi-calendar2-week me-1"></i>Xem lich hen
                        </a>
                    }
                </div>
                @if (!tb.DaDoc)
                {
                    <div class="tb-dot" title="Chua doc"></div>
                }
            </div>
        }
    }
</div>
